{
    "name": "mudrava/mudrava-migration-backup",
    "description": "Migrate, back up and restore WordPress sites using one portable .mudrava file.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "php-stubs/wordpress-stubs": "^6.8",
        "phpcompatibility/php-compatibility": "^9.3",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.2",
        "phpstan/phpstan": "^1.12",
        "szepeviktor/phpstan-wordpress": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Mudrava\\Migration\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mudrava\\Migration\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "headers": "bin/check-headers.sh",
        "stan": "phpstan analyse --memory-limit=1G",
        "dist": "bin/dist.sh",
        "dist:repro": "bin/verify-reproducible-dist.sh",
        "verify-dist": "bin/verify-dist.sh",
        "check": [
            "@headers",
            "@lint",
            "@stan",
            "@test"
        ]
    }
}
