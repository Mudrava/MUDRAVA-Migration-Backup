msgstr "задача"

msgid "missing parts"
msgstr "нет частей"

msgid "or click to browse. For split sets, select every part"
msgstr "или нажмите для выбора. Для наборов выбирайте все части"

msgid "part"
msgstr "часть"

msgid "part(s)"
msgstr "част."

msgid "parts"
msgstr "части"

msgid "rows"
msgstr "строк"

msgid "running"
msgstr "выполняется"

msgid "set complete"
msgstr "набор полон"

